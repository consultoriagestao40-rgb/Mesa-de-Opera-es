generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(OPERATOR)
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  audit_logs    AuditLog[]
}

model Collaborator {
  id          String   @id @default(uuid())
  name        String
  pis         String?  @unique
  secullumId  String?  @unique
  posto       String?  // Local de Trabalho / Posto
  departamento String? // Departamento / Shopping vinculado
  phone        String? // Telefone/Celular para avisos privados
  status       String   @default("DESCONHECIDO") // Trabalhando, Folga, Ferias, Afastado, Justificado, etc.
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  alert_cycles AlertCycle[]
}

model AlertCycle {
  id                String       @id @default(uuid())
  collaborator_id   String
  collaborator      Collaborator @relation(fields: [collaborator_id], references: [id])
  
  date              DateTime     // Data da ocorrência
  expected_time     DateTime     // Horário previsto da batida
  event_type        EventType    // ENTRADA, INTERVALO_SAIDA, INTERVALO_RETORNO, SAIDA
  
  status            AlertStatus  @default(PENDENTE)
  current_step      Int          @default(0) // 0, 1 (5min), 2 (15min), 3 (25min)
  
  last_alert_at     DateTime?
  completed_at      DateTime?    // Quando a batida foi detectada
  cancelled_at      DateTime?
  
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@index([collaborator_id, date])
  @@index([status])
}

model NexusConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String
  entity_id   String
  action      String
  user_id     String?
  timestamp   DateTime @default(now())
  details     Json?
  user        User?    @relation(fields: [user_id], references: [id])
}

enum Role {
  OPERATOR
  SUPERVISOR
  MANAGER
  ADMIN
  CLIENT
}

enum EventType {
  ENTRADA
  INTERVALO_SAIDA
  INTERVALO_RETORNO
  SAIDA
}

enum AlertStatus {
  PENDENTE
  EM_ALERTA
  CONCLUIDO    // Batida realizada
  ENCERRADO    // Passou dos 30 min sem batida (Ciclo finalizado)
  CANCELADO
}
